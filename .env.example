# NEURALVERSE — environment template
# Copy to .env for local development. Never commit .env with secrets.
# Frontend demo config only — never put real API keys in frontend code.

# Optional: backend proxy URL for AI assistant (leave empty = demo mode)
VITE_AI_PROXY_URL=

# Optional: public site URL
VITE_SITE_URL=http://localhost:5173

# Demo flag
VITE_DEMO_MODE=true
